[Unit]
Description=Run Milo's nightly ledger replay evaluation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/ai/local-ai-lab/audio/milo
ExecStart=/usr/bin/python3 -m evaluations.replay --url http://127.0.0.1:8776 --path /api/demo/turn --label nightly --grow %h/.local/state/milo/replay-grown.json --compare-latest
